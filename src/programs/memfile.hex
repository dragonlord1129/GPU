@0000
63000303    // LW R3, 0x303(R0)   ; limit = 16
6400030A    // LW R4, 0x30A(R0)   ; increment = 1
02000000    // ADD R2, R0, R0      ; counter = 0
// loop start (PC = 3)
80230006    // BEQ R2, R3, exit    ; if counter == 16 -> PC = 10
02420000    // ADD R2, R2, R4      ; counter++
00000000    // NOP
00000000    // NOP
90000003    // JUMP 3              ; back to loop start
00000000    // NOP (after jump)
00000000    // NOP
// exit (PC = 10)
69000305    // LW R9, 0x305(R0)   ; base = 0x400
00000000    // NOP
70920000    // SW  R2, 0(R9)       ; store final counter
A0000000    // HALT (PC = 14)